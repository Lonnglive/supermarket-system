# ==============================================================================
# SMALL SUPERMARKET MANAGEMENT SYSTEM - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development

# PostgreSQL Database Configuration
# NOTE: Set your PostgreSQL password below.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=supermarket_db
DB_USER=postgres
DB_PASSWORD=
# Optional full connection URL (overrides DB_* if provided):
# DATABASE_URL=postgresql://postgres:your_password@localhost:5432/supermarket_db

# Security & Authentication
JWT_SECRET=aeropos_supermarket_jwt_secret_key_change_in_production_2026_xyz
JWT_EXPIRES_IN=12h
FAILED_LOGIN_LIMIT=5
LOCKOUT_TIME_MINUTES=15

# Store Profile Defaults
STORE_NAME=FreshMart Supermarket
STORE_PHONE=+1 (555) 019-2834
STORE_EMAIL=manager@freshmart.com
STORE_ADDRESS=742 Evergreen Terrace, Springfield
STORE_TAX_NUMBER=GSTIN29ABCDE1234F1Z5
STORE_CURRENCY=₹
STORE_RECEIPT_WIDTH=200

# Email / SMTP Configuration
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_SECURE=false
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
EMAIL_FROM="FreshMart Supermarket" <noreply@freshmart.com>

# Daily Sales Email Report
DAILY_REPORT_ENABLED=true
DAILY_REPORT_CRON="0 23 * * *"
SUPER_ADMIN_REPORT_EMAIL=owner@freshmart.com
